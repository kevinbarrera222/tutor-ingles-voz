# Copia este archivo como .env y pon tu clave de OpenAI
OPENAI_API_KEY=sk-...

# Duración máxima de cada conversación (minutos)
MAX_MINUTOS_SESION=5

# Sesiones permitidas por día para cada visitante (por IP)
MAX_SESIONES_POR_DIA=20

# (Opcional) Modelos y voz
# MODELO_VOZ=gpt-realtime-2.1-mini
# MODELO_TRANSCRIPCION=gpt-transcribe
# MODELO_EVALUACION=gpt-6-luna
# VOZ=marin
